#!/usr/bin/env python3
"""OpenAurum: light Space when a message arrives (openaurum-notify.service).

Watches the session bus for org.freedesktop.Notifications.Notify, whatever
the notification daemon, and runs `openaurum-cli notify --app NAME` for
messages: category im.* (ZapZap sends im.received) or a messenger in
openaurum.alerts.MESSENGERS. Nothing while Do Not Disturb is on (mako /
swaync). Only the app name, desktop entry and category are read, never the
summary or the text.

  openaurum-notify          # what the service runs
"""

import os
import signal
import subprocess
import sys

_root = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
for _p in (_root, os.path.join(_root, "share", "openaurum")):
    if os.path.isfile(os.path.join(_p, "openaurum", "protocol.py")):
        sys.path.insert(0, _p)
        break
from openaurum import alerts, integrations  # noqa: E402

from gi.repository import Gio, GLib  # noqa: E402

CLI = os.path.join(os.path.dirname(os.path.realpath(__file__)), "openaurum-cli")
RULE = "type='method_call',interface='org.freedesktop.Notifications',member='Notify'"


def hint(hints, name):
    v = hints.lookup_value(name, GLib.VariantType.new("s"))
    return v.get_string() if v else ""


def on_notify(app, entry, category):
    if not (category.startswith("im.") or alerts.app_color(app, entry)):
        return False
    if integrations.do_not_disturb():
        return False
    subprocess.Popen([CLI, "notify", "--app", entry or app],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return False  # GLib.idle_add: once


def on_message(conn, msg, incoming):
    # GDBus worker thread: only read the call here, act in the main loop
    if not (incoming and msg.get_message_type() == Gio.DBusMessageType.METHOD_CALL
            and msg.get_member() == "Notify"
            and msg.get_interface() == "org.freedesktop.Notifications"):
        return msg  # e.g. the reply to BecomeMonitor
    body = msg.get_body()
    if body is not None and body.n_children() >= 7:
        hints = body.get_child_value(6)
        GLib.idle_add(on_notify, body.get_child_value(0).get_string(),
                      hint(hints, "desktop-entry"), hint(hints, "category"))
    return None  # a copy of someone else's call: GDBus must not answer it (monitors can't send)


def main():
    signal.signal(signal.SIGCHLD, signal.SIG_IGN)  # openaurum-cli children reap themselves
    address = Gio.dbus_address_get_for_bus_sync(Gio.BusType.SESSION, None)
    conn = Gio.DBusConnection.new_for_address_sync(
        address, Gio.DBusConnectionFlags.AUTHENTICATION_CLIENT
        | Gio.DBusConnectionFlags.MESSAGE_BUS_CONNECTION, None, None)
    conn.add_filter(on_message)
    conn.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus",
                   "org.freedesktop.DBus.Monitoring", "BecomeMonitor",
                   GLib.Variant("(asu)", ([RULE], 0)), None, Gio.DBusCallFlags.NONE, -1, None)
    GLib.MainLoop().run()


if __name__ == "__main__":
    main()
